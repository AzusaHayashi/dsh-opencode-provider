{
  "name": "dsh-opencode-provider",
  "version": "0.1.0",
  "description": "Use OpenCode models inside DeepSeek Harness without a separate provider API key.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "llm",
    "ai-agent",
    "coding-agent"
  ],
  "homepage": "https://github.com/goku54477/dsh-opencode-provider#readme",
  "bugs": {
    "url": "https://github.com/goku54477/dsh-opencode-provider/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goku54477/dsh-opencode-provider.git"
  },
  "author": "Jacob James",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/invariant.mjs",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run test",
    "prepack": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
